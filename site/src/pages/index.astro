---
import Base from "../layouts/Base.astro";

const repo = "https://github.com/MaxTheTurtle0/wren";
const blob = `${repo}/blob/main`;

// Every fact on this page comes from the repository's README.md and docs/.
// Keep it in step with those files; don't add claims they don't make.

// docs/performance.md, native release builds on macOS 27 with 16 GiB RAM.
const stats = [
  { from: 101, to: 120, unit: "ms", label: "Launch to first frame", note: "six demo launches, Mac mini" },
  { to: 0, decimals: 1, unit: "%", label: "Idle CPU, window open", note: "settled, on both Macs" },
  { to: 16, prefix: "about ", unit: "MiB", label: "Binary / app bundle", note: "one small binary" },
];

const memScale = 320; // MiB at the right edge of the chart
const memory: { label: string; mini?: number; air?: number; peak?: number }[] = [
  { label: "App, offline demo, settled", mini: 57 },
  { label: "App signed in, after restart", air: 130 },
  { label: "Performance fixture, idle", mini: 57, air: 122 },
  { label: "After 20 full HD image previews, viewer closed", mini: 88, air: 161 },
  { label: "After 100 full HD image previews", mini: 92 },
  { label: "After five 4K image previews", mini: 159, peak: 317 },
];

type Status = "ok" | "exp" | "no";
const features: { name: string; status: Status; label: string; note?: string }[] = [
  { name: "Chats: list, unread, history, send, quote replies, reactions, edit, delete, mark read", status: "ok", label: "Implemented" },
  { name: "New chats, @mentions in the composer, sending files", status: "ok", label: "Implemented", note: "OneDrive upload and sharing" },
  { name: "Rich text, mentions, emoji, links, code, inline images", status: "ok", label: "Implemented", note: "Native rendering of Teams HTML" },
  { name: "Images in chats and drafts", status: "ok", label: "Implemented", note: "Cropped draft thumbnails; click either for the same full preview with fit and 100% views" },
  { name: "Teams and channels, threaded posts and replies", status: "ok", label: "Implemented", note: "Reading channel posts needs admin consent" },
  { name: "Local full-text search plus Microsoft Search, ⌘K switcher", status: "ok", label: "Implemented" },
  { name: "Calendar, meeting reminders, Join", status: "ok", label: "Implemented" },
  { name: "Calls and meetings", status: "ok", label: "In Teams on the web", note: "In its own Edge or Chrome window beside Wren, with the meeting chat and a call bar in Wren" },
  { name: "Presence, photos", status: "ok", label: "Implemented" },
  { name: "Light, dark and system themes, 8 palettes, keyboard shortcuts, tray, notifications", status: "ok", label: "Implemented" },
  { name: "Multiple accounts, setting your availability and status message", status: "ok", label: "Implemented" },
  { name: "Offline demo mode", status: "ok", label: "Implemented", note: "wren --demo" },
  { name: "App updates", status: "ok", label: "Implemented", note: "Daily checks and verified downloads from GitHub releases; restart when ready" },
  { name: "Real-time updates on open, focus and refresh", status: "ok", label: "Implemented" },
  { name: "Push through a self-hostable wren-relay", status: "exp", label: "Experimental", note: "Microsoft forbids polling" },
  { name: "Audio and video inside Wren's own window, incoming calls", status: "no", label: "Not possible", note: "No free official way: Microsoft's licence covers call media only in its own clients" },
];

const hosts = [
  { host: "login.microsoftonline.com", tag: "Sign-in", what: "You enter your password on Microsoft's page in your browser, never in Wren." },
  { host: "graph.microsoft.com", tag: "Your data", what: "Your chats, channels, meetings, presence and photos. The only place the access token is sent." },
  { host: "Your organisation's OneDrive host", tag: "Large files", what: "Files larger than 4 MiB, sent to the one-time upload URL Graph returns, without the Graph token." },
  { host: "github.com", tag: "Updates", what: "Update checks, at most daily, and downloads. Can be turned off. No Microsoft credentials or account data." },
  { host: "Your own wren-relay", tag: "Push, optional", what: "It forwards Graph's change notifications, which carry no message content.", optional: true },
];

const keys = [
  ["⌘K", "Jump anywhere or search messages"],
  ["⌘N", "New chat"],
  ["⌘1–4", "Sections"],
  ["Alt ↑ ↓", "Previous or next conversation"],
  ["⌘⇧A", "Next account"],
  ["↑", "Edit last message"],
  ["⌘R", "Refresh"],
  ["⌘,", "Settings"],
  ["⌘/", "All shortcuts"],
];
---

<Base
  title="Wren: a native client for Microsoft Teams"
  description="A fast, native client for Microsoft Teams chats, channels and meetings. Rust and egui, official Microsoft Graph APIs only."
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="/">
        <img src="/wren-256.png" width="26" height="26" alt="" />
        Wren
      </a>
      <nav aria-label="Sections">
        <a href="#features">Features</a>
        <a href="#connections">Connections</a>
        <a href="#start">Get started</a>
        <a href={repo}>GitHub</a>
      </nav>
      <div class="seg" role="radiogroup" aria-label="Colour theme">
        <button type="button" role="radio" data-set="system" aria-checked="true">System</button>
        <button type="button" role="radio" data-set="light" aria-checked="false">Light</button>
        <button type="button" role="radio" data-set="dark" aria-checked="false">Dark</button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <img class="hero-icon ld" style="--d:0ms" src="/wren-256.png" width="72" height="72" alt="Wren icon" />
        <h1 class="ld" style="--d:80ms">A fast, native client for Microsoft&nbsp;Teams chats, channels and meetings.</h1>
        <p class="lede ld" style="--d:180ms">
          Rust and egui. No browser engine. Works with Microsoft Teams through Microsoft's official APIs.
        </p>
        <div class="actions ld" style="--d:260ms">
          <a class="btn primary" href={repo}>View on GitHub</a>
          <a class="btn" href="#start">Run the demo</a>
        </div>
        <p class="meta ld" style="--d:340ms">
          <span>v0.1 early preview</span><span>MIT</span><span>macOS</span><span>Linux</span><span>Windows</span>
        </p>
      </div>
      <div class="hero-shot">
        <picture>
          <source srcset="/shots/chats-dark.png" media="(prefers-color-scheme: dark)" data-dark />
          <img
            class="shot"
            src="/shots/chats-light.png"
            data-light="/shots/chats-light.png"
            data-darksrc="/shots/chats-dark.png"
            width="1280"
            height="800"
            alt="Wren's chat view with a conversation open, from the offline demo"
            fetchpriority="high"
          />
        </picture>
      </div>
    </section>

    <section id="performance" class="sec perf">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Performance</h2>
          <p>
            Release builds on macOS 27 with 16 GiB RAM: an M4 Mac mini with a 1× display and an M3 MacBook Air with a
            2× Retina display.
          </p>
          <p><a href={`${blob}/docs/performance.md`}>Method and raw results</a></p>
        </header>
        <div class="sec-body">
          <dl class="stats">
            {
              stats.map((s, i) => (
                <div class="stat rv" style={`--d:${i * 90}ms`}>
                  <dt>{s.label}</dt>
                  <dd class="val">
                    {s.prefix && <span class="approx">{s.prefix}</span>}
                    {s.from !== undefined && (
                      <>
                        <span data-count={s.from}>{s.from}</span>–
                      </>
                    )}
                    <span data-count={s.to} data-decimals={s.decimals ?? 0}>
                      {s.to.toFixed(s.decimals ?? 0)}
                    </span>
                    <span class="unit">{s.unit}</span>
                  </dd>
                  <dd class="note">{s.note}</dd>
                </div>
              ))
            }
          </dl>

          <figure class="mem rv">
            <figcaption>
              <h3>Memory, physical footprint</h3>
              <ul class="legend">
                <li><i class="k mini" />Mac mini</li>
                <li><i class="k air" />MacBook Air</li>
                <li><i class="k peak" />Peak during the run</li>
              </ul>
            </figcaption>
            <div class="mem-rows" style={`--scale:${memScale}`}>
              {
                memory.map((m, i) => (
                  <div class="mem-row" style={`--i:${i}`}>
                    <span class="mem-label">{m.label}</span>
                    <div class="mem-bars">
                      {m.mini !== undefined && (
                        <div class="mem-bar mini" style={`--v:${m.mini}`}>
                          {m.peak !== undefined && <span class="peak" style={`--p:${m.peak}`} title={`Peaked at ${m.peak} MiB`} />}
                          <b />
                          <span class="mem-val">
                            <span data-count={m.mini}>{m.mini}</span> MiB
                            {m.peak !== undefined && <em> · peak {m.peak}</em>}
                          </span>
                        </div>
                      )}
                      {m.air !== undefined && (
                        <div class="mem-bar air" style={`--v:${m.air}`}>
                          <b />
                          <span class="mem-val"><span data-count={m.air}>{m.air}</span> MiB</span>
                        </div>
                      )}
                    </div>
                  </div>
                ))
              }
              <div class="axis" aria-hidden="true">
                <span style="--t:0">0</span>
                <span style="--t:100">100</span>
                <span style="--t:200">200</span>
                <span style="--t:300">300 MiB</span>
              </div>
            </div>
            <p class="mem-note">
              Short measurements; they do not establish a long-session footprint. Microsoft Teams was not measured side
              by side.
            </p>
          </figure>
        </div>
      </div>
    </section>

    <section id="features" class="sec">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Features</h2>
          <p>
            Microsoft's Teams client is a large web application. Wren is one small binary, a window that draws only
            when something changes, and every view served from a local cache first.
          </p>
          <p><a href={`${blob}/docs/features.md`}>What was verified, and how</a></p>
        </header>
        <div class="sec-body">
          <table class="ftable rv">
            <thead>
              <tr><th scope="col">Feature</th><th scope="col">Status</th><th scope="col">Notes</th></tr>
            </thead>
            <tbody>
              {
                features.map((f, i) => (
                  <tr style={`--i:${i}`}>
                    <th scope="row">{f.name}</th>
                    <td><span class={`st ${f.status}`}><i aria-hidden="true" />{f.label}</span></td>
                    <td class="fnote">{f.note === "wren --demo" ? <code>wren --demo</code> : f.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <div class="pair rv">
            <figure>
              <img src="/shots/channel-dark.png" width="1280" height="800" loading="lazy" alt="A channel with threaded replies, dark theme" />
              <figcaption>A channel with threaded replies</figcaption>
            </figure>
            <figure>
              <img src="/shots/calendar-light.png" width="1280" height="800" loading="lazy" alt="The calendar, light theme" />
              <figcaption>The calendar in light mode</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section id="connections" class="sec">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Connections</h2>
          <p>There is no telemetry and no Wren server. This is every host Wren talks to.</p>
          <p><a href={`${blob}/docs/privacy.md`}>Privacy and security</a></p>
        </header>
        <div class="sec-body">
          <div class="net rv" data-net>
            <svg class="net-svg" aria-hidden="true"></svg>
            <div class="net-node">
              <img src="/wren-256.png" width="44" height="44" alt="" />
              <span>Wren<small>on your computer</small></span>
            </div>
            <ul class="net-hosts">
              {
                hosts.map((h, i) => (
                  <li class={`host${h.optional ? " opt" : ""}`} style={`--d:${200 + i * 110}ms`}>
                    <span class="tag">{h.tag}</span>
                    <code>{h.host}</code>
                    <p>{h.what}</p>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="never rv">
            <h3>Not on the list</h3>
            <ul>
              <li><s>A Wren server</s> There isn't one.</li>
              <li><s>Telemetry</s> None, of any kind.</li>
              <li><s>Images hosted elsewhere</s> Not loaded, so senders can't track when you read a message.</li>
            </ul>
          </div>
          <div class="facts rv">
            <div>
              <h3>Tokens</h3>
              <p>
                The refresh token lives in the OS credential store: Keychain, Windows Credential Manager or Secret
                Service. Access tokens stay in memory.
              </p>
            </div>
            <div>
              <h3>Your messages</h3>
              <p>Cached only on your computer, in a folder only your user can read. Signing out deletes them.</p>
            </div>
            <div>
              <h3>Logs</h3>
              <p>Never contain message text, tokens, authorization codes or URLs with query strings.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="limits" class="sec">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Known limitations</h2>
          <p>Set by Microsoft's APIs and terms, not by Wren.</p>
        </header>
        <div class="sec-body limits rv">
          <div>
            <h3>Calling</h3>
            <p>
              Graph's calling API is application-only and meant for bots. Wren opens calls in Teams on the web beside
              itself and follows them from there. <a href={`${blob}/docs/calling.md`}>Details</a>
            </p>
          </div>
          <div>
            <h3>Real-time</h3>
            <p>
              Polling Graph for Teams changes more than once a day breaks the Microsoft APIs Terms of Use. Wren
              refreshes when you look. For push, you run the small <code>wren-relay</code> on any HTTPS host.{" "}
              <a href={`${blob}/docs/realtime.md`}>Details</a>
            </p>
          </div>
          <div>
            <h3>Consent</h3>
            <p>Expect an administrator to approve Wren's permissions in your tenant.</p>
          </div>
          <div>
            <h3>Accounts</h3>
            <p>
              Personal Microsoft accounts and Teams (free) are not supported. Graph's Teams APIs serve work and school
              accounts only.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="start" class="sec">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Get started</h2>
          <p>Nothing is published as a release yet. Build from source.</p>
        </header>
        <div class="sec-body steps">
          <div class="step rv">
            <h3><span>1</span>Try the demo, no account needed</h3>
            <div class="term">
              <pre><code><b>$</b> git clone https://github.com/MaxTheTurtle0/wren && cd wren
<b>$</b> cargo run --release -- --demo</code></pre>
              <button class="copy" type="button" data-copy="git clone https://github.com/MaxTheTurtle0/wren && cd wren
cargo run --release -- --demo">Copy</button>
            </div>
            <p class="aside">
              Linux needs <code>libxkbcommon-dev libwayland-dev libgl1-mesa-dev</code> (Debian and Ubuntu package
              names) to build.
            </p>
          </div>

          <div class="step rv">
            <h3><span>2</span>Use it with your Microsoft 365 account</h3>
            <ol>
              <li>
                Register the app in your organisation's Entra ID. About five minutes, no secrets.{" "}
                <a href={`${blob}/docs/azure-app-registration.md`}>Guide</a>
              </li>
              <li>
                Start Wren, enter the <b>Application (client) ID</b> and your <b>tenant</b>, and select{" "}
                <b>Sign in with Microsoft</b>. Or set <code>WREN_CLIENT_ID</code> and <code>WREN_TENANT</code>.
              </li>
              <li>
                In most tenants an administrator approves <code>Chat.ReadWrite</code> and <code>Calendars.Read</code>,
                and <code>ChannelMessage.Read.All</code> for channel posts. Wren shows an admin-consent link under{" "}
                <b>Settings</b>. <a href={`${blob}/docs/permissions.md`}>Every permission, explained</a>
              </li>
            </ol>
          </div>

          <div class="step rv">
            <h3><span>3</span>Build packages</h3>
            <table class="ptable">
              <tbody>
                <tr>
                  <th scope="row">macOS</th>
                  <td>
                    Set <code>CODESIGN_IDENTITY</code>, then{" "}
                    <code class="cmd">cargo build --release && packaging/macos/bundle.sh target/release/wren Wren.app 0.1.0</code>
                  </td>
                </tr>
                <tr>
                  <th scope="row">Linux</th>
                  <td>
                    <code class="cmd">cargo build --release && packaging/linux/install.sh</code>
                    Installs to <code>~/.local</code>.
                  </td>
                </tr>
                <tr>
                  <th scope="row">Windows</th>
                  <td>
                    <code class="cmd">cargo build --release</code>
                    Icon and version embedded by <code>build.rs</code>.
                  </td>
                </tr>
              </tbody>
            </table>
            <p class="aside">
              Checked natively on macOS (Apple Silicon). Windows and Linux compile and pass tests in CI; their native
              windows have not been inspected yet.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap sec-grid">
        <header class="sec-head rv">
          <h2>Keyboard</h2>
          <p><kbd>⌘</kbd> is Ctrl on Windows and Linux.</p>
        </header>
        <ul class="sec-body keys rv">
          {keys.map(([k, v]) => (<li><kbd>{k}</kbd>{v}</li>))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-l">
        <a class="brand" href="/"><img src="/wren-256.png" width="22" height="22" alt="" loading="lazy" />Wren</a>
        <p>
          MIT licence. Wren is an independent project, not affiliated with or endorsed by Microsoft. Microsoft Teams is
          a trademark of the Microsoft group of companies.
        </p>
      </div>
      <nav class="foot-r" aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={`${blob}/SECURITY.md`}>Security</a>
        <a href="https://ma2.dev" class="more">More projects by Andrei</a>
      </nav>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const shot = document.querySelector<HTMLImageElement>("img.shot");
    const source = document.querySelector<HTMLSourceElement>("source[data-dark]");
    const buttons = document.querySelectorAll<HTMLButtonElement>(".seg button");
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function apply(mode: string) {
      if (mode === "light" || mode === "dark") root.dataset.theme = mode;
      else delete root.dataset.theme;
      buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.set === mode)));
      if (shot && source) {
        if (root.dataset.theme) {
          source.media = "not all";
          shot.src = root.dataset.theme === "dark" ? shot.dataset.darksrc! : shot.dataset.light!;
        } else {
          source.media = "(prefers-color-scheme: dark)";
          shot.src = shot.dataset.light!;
        }
      }
    }

    apply(root.dataset.theme ?? "system");
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const mode = b.dataset.set!;
        apply(mode);
        try {
          if (mode === "system") localStorage.removeItem("wren-theme");
          else localStorage.setItem("wren-theme", mode);
        } catch {}
      }),
    );

    document.querySelectorAll<HTMLButtonElement>(".copy").forEach((b) => {
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? "");
          b.textContent = "Copied";
        } catch {
          b.textContent = "Copy failed";
        }
        setTimeout(() => (b.textContent = "Copy"), 1500);
      });
    });

    // Count numbers up from zero when they scroll into view.
    function countUp(el: HTMLElement) {
      const to = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals ?? 0);
      if (still || to === 0) return;
      const start = performance.now();
      const duration = 1100;
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = (to * eased).toFixed(decimals);
        if (t < 1) requestAnimationFrame(step);
      };
      el.textContent = (0).toFixed(decimals);
      requestAnimationFrame(step);
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("in");
          e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
    );
    document.querySelectorAll(".rv").forEach((el) => io.observe(el));

    // Connection wires: curves from the Wren node to each host card, with
    // small packets travelling along them.
    const net = document.querySelector<HTMLElement>("[data-net]");
    const svg = net?.querySelector<SVGSVGElement>(".net-svg");
    const node = net?.querySelector<HTMLElement>(".net-node");
    const hostEls = net ? [...net.querySelectorAll<HTMLElement>(".host")] : [];
    const NS = "http://www.w3.org/2000/svg";

    function drawWires() {
      if (!net || !svg || !node) return;
      const box = net.getBoundingClientRect();
      const n = node.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      const stacked = n.bottom <= hostEls[0].getBoundingClientRect().top + 1;
      hostEls.forEach((el, i) => {
        const c = el.getBoundingClientRect();
        const y1 = c.top - box.top + Math.min(c.height / 2, 26);
        const x1 = c.left - box.left;
        let d: string;
        if (stacked) {
          const x0 = n.left - box.left + 22;
          const y0 = n.bottom - box.top;
          d = `M${x0} ${y0} V${y1 - 12} Q${x0} ${y1} ${x0 + 12} ${y1} H${x1}`;
        } else {
          const x0 = n.right - box.left;
          const y0 = n.top - box.top + n.height / 2;
          const mid = x0 + (x1 - x0) / 2;
          d = `M${x0} ${y0} C${mid} ${y0} ${mid} ${y1} ${x1} ${y1}`;
        }
        const wire = document.createElementNS(NS, "path");
        wire.setAttribute("d", d);
        wire.setAttribute("pathLength", "1");
        wire.setAttribute("class", `wire${el.classList.contains("opt") ? " opt" : ""}`);
        wire.style.setProperty("--d", `${i * 110}ms`);
        wire.dataset.i = String(i);
        svg.append(wire);
        if (!still) {
          const dot = document.createElementNS(NS, "circle");
          dot.setAttribute("r", "3");
          dot.setAttribute("class", "packet");
          const move = document.createElementNS(NS, "animateMotion");
          move.setAttribute("path", d);
          move.setAttribute("dur", `${2.2 + (i % 3) * 0.5}s`);
          move.setAttribute("begin", `${(svg.getCurrentTime?.() ?? 0) + 0.9 + i * 0.35}s`);
          move.setAttribute("repeatCount", "indefinite");
          move.setAttribute("calcMode", "linear");
          // Requests go out; replies come back.
          move.setAttribute("keyPoints", i % 2 ? "1;0" : "0;1");
          move.setAttribute("keyTimes", "0;1");
          // Hidden until its motion starts, or it would sit at the origin.
          dot.setAttribute("visibility", "hidden");
          const show = document.createElementNS(NS, "set");
          show.setAttribute("attributeName", "visibility");
          show.setAttribute("to", "visible");
          show.setAttribute("begin", move.getAttribute("begin")!);
          dot.append(move, show);
          svg.append(dot);
        }
      });
    }

    if (net) {
      drawWires();
      new ResizeObserver(drawWires).observe(net);
      document.fonts?.ready.then(drawWires);
      hostEls.forEach((el, i) => {
        const on = (v: boolean) => svg?.querySelector(`.wire[data-i="${i}"]`)?.classList.toggle("hot", v);
        el.addEventListener("pointerenter", () => on(true));
        el.addEventListener("pointerleave", () => on(false));
      });
    }
  </script>

