{
  // Static assets only: no Worker script runs. `npm run deploy` builds dist/ first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-wren",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "wren.ma2.dev", "custom_domain": true }]
}
